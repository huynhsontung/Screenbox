<ContentDialog
    x:Class="Screenbox.Dialogs.DeleteMediaDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Screenbox.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:strings="using:Screenbox.Strings"
    CloseButtonText="{x:Bind strings:Resources.Cancel}"
    DefaultButton="Primary"
    PrimaryButtonText="{x:Bind strings:Resources.Delete}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Title>
        <TextBlock
            MaxLines="2"
            Text="{x:Bind strings:Resources.DeleteItemConfirmation(MediaName)}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="Wrap">
            <interactivity:Interaction.Behaviors>
                <behaviors:OverflowTextToolTipBehavior />
            </interactivity:Interaction.Behaviors>
        </TextBlock>
    </ContentDialog.Title>

    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind strings:Resources.DeleteItemSubtitle}" />
</ContentDialog>
