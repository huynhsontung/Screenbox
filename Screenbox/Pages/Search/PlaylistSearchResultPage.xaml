<Page
    x:Class="Screenbox.Pages.PlaylistSearchResultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Screenbox.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:flyouts="using:Screenbox.Flyouts"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:Screenbox.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:strings="using:Screenbox.Strings"
    xmlns:templates="using:Screenbox.Templates"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <templates:GridViewItemTemplates />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="HeaderText"
            Grid.Row="0"
            MinHeight="{StaticResource PageHeaderMinHeight}"
            Margin="{StaticResource BottomMediumMargin}"
            Padding="{StaticResource ContentPagePadding}"
            MaxLines="2"
            Style="{StaticResource TitleMediumTextBlockStyle}"
            Text="{x:Bind strings:Resources.SearchResultPlaylistHeader(ViewModel.SearchQuery), FallbackValue={}}" />

        <GridView
            x:Name="PlaylistGridView"
            Grid.Row="1"
            Margin="{StaticResource TopLargeMargin}"
            Padding="{StaticResource GridViewContentPagePadding}"
            ui:ListViewExtensions.Command="{x:Bind Common.OpenPlaylistCommand}"
            ui:ScrollViewerExtensions.VerticalScrollBarMargin="{x:Bind Common.ScrollBarMargin, Mode=OneWay}"
            IsItemClickEnabled="True"
            ItemContainerStyle="{StaticResource GridViewItemMediaCardStyle}"
            ItemTemplate="{StaticResource PlaylistGridViewItemTemplate}"
            ItemsSource="{x:Bind ViewModel.SearchResult.Playlists, FallbackValue={}}"
            SelectionMode="None">
            <GridView.Footer>
                <Grid Height="{x:Bind Common.FooterBottomPaddingHeight, Mode=OneWay}" />
            </GridView.Footer>
            <interactivity:Interaction.Behaviors>
                <behaviors:ListViewContextBehavior ContextItem="{x:Bind ViewModel.ContextPlaylist, Mode=TwoWay}">
                    <behaviors:ListViewContextBehavior.Flyout>
                        <flyouts:MediaMenuFlyout
                            AddToQueueCommand="{x:Bind ViewModel.ContextPlaylist.AddToQueueCommand, Mode=OneWay}"
                            ContextItem="{x:Bind ViewModel.ContextPlaylist, Mode=OneWay}"
                            IsAddToPlaylistButtonVisible="False"
                            IsAdvancedModeEnabled="{x:Bind Common.IsAdvancedModeEnabled}"
                            PlayCommand="{x:Bind ViewModel.ContextPlaylist.PlayCommand, Mode=OneWay}"
                            PlayNextCommand="{x:Bind ViewModel.ContextPlaylist.PlayNextCommand, Mode=OneWay}" />
                    </behaviors:ListViewContextBehavior.Flyout>
                </behaviors:ListViewContextBehavior>
                <behaviors:ThumbnailGridViewBehavior />
            </interactivity:Interaction.Behaviors>
        </GridView>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="NavigationViewStates">
                <VisualState x:Name="Expanded" />
                <VisualState x:Name="Compact" />
                <VisualState x:Name="Minimal">
                    <VisualState.StateTriggers>
                        <ui:IsEqualStateTrigger Value="{x:Bind Common.NavigationViewDisplayMode, Mode=OneWay}" To="{StaticResource MinimalNavigationViewDisplayMode}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderText.Padding" Value="{StaticResource ContentPageMinimalPadding}" />
                        <Setter Target="PlaylistGridView.Padding" Value="{StaticResource GridViewContentPageMinimalPadding}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
