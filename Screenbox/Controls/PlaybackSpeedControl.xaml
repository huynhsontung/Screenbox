<UserControl
    x:Class="Screenbox.Controls.PlaybackSpeedControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Screenbox.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sbui="using:Screenbox.UI"
    xmlns:strings="using:Screenbox.Strings"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            MinHeight="48"
            BorderBrush="{ThemeResource SystemControlForegroundTransparentBrush}"
            BorderThickness="{StaticResource CommandBarOverflowPresenterBorderDownThickness}">
            <TextBlock
                Padding="12,0,12,0"
                VerticalAlignment="Center"
                Text="{x:Bind strings:Resources.PlaybackSpeed}" />
        </Grid>

        <TextBlock
            Grid.Row="1"
            Margin="0,8,0,0"
            HorizontalAlignment="Center"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="{x:Bind FormatPlaybackRate(PlaybackSession.PlaybackRate), Mode=OneWay}"
            Typography.NumeralAlignment="Tabular" />

        <!--#region PlaybackRate Slider-->
        <Grid
            Grid.Row="2"
            Margin="8,12,8,16"
            ColumnSpacing="8"
            FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <RepeatButton
                x:Name="DecreasePlaybackRateButton"
                Grid.Column="0"
                MinWidth="32"
                Padding="0"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="{x:Bind strings:Resources.DecreaseValue(strings:Resources.PlaybackSpeed)}"
                Background="{ThemeResource SubtleButtonBackground}"
                BorderThickness="0"
                Click="DecreaseRateButton_OnClick"
                Content="&#xF8AB;"
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                FontSize="12"
                IsTextScaleFactorEnabled="False" />

            <Slider
                x:Name="SpeedSlider"
                Grid.Column="1"
                IsThumbToolTipEnabled="False"
                Maximum="2"
                Minimum="0"
                SmallChange="0.01"
                StepFrequency="0.05"
                ValueChanged="SpeedSlider_OnValueChanged"
                Value="{x:Bind PlaybackSession.PlaybackRate, Mode=TwoWay}" />

            <RepeatButton
                x:Name="IncreasePlaybackRateButton"
                Grid.Column="2"
                MinWidth="32"
                Padding="0"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="{x:Bind strings:Resources.IncreaseValue(strings:Resources.PlaybackSpeed)}"
                Background="{ThemeResource SubtleButtonBackground}"
                BorderThickness="0"
                Click="IncreaseRateButton_OnClick"
                Content="&#xF8AA;"
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                FontSize="12"
                IsTextScaleFactorEnabled="False" />
        </Grid>
        <!--#endregion-->

        <!--#region PlaybackRate Buttons-->
        <Grid
            Grid.Row="3"
            Padding="12,0,12,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ToggleButton
                Grid.Column="0"
                Padding="3,5,3,6"
                HorizontalAlignment="Stretch"
                Click="PlaybackRateToggleButton_OnClick"
                Command="{x:Bind PlaybackSession.SetPlaybackRateCommand}"
                CommandParameter="{x:Bind local:PlaybackSpeedControl.Speed075}"
                Content="{x:Bind FormatPlaybackRate(local:PlaybackSpeedControl.Speed075)}"
                CornerRadius="16"
                IsChecked="{x:Bind sbui:DoubleHelper.AreClose(local:PlaybackSpeedControl.Speed075, PlaybackSession.PlaybackRate), Mode=OneWay}" />

            <ToggleButton
                Grid.Column="1"
                Padding="3,5,3,6"
                HorizontalAlignment="Stretch"
                Click="PlaybackRateToggleButton_OnClick"
                Command="{x:Bind PlaybackSession.SetPlaybackRateCommand}"
                CommandParameter="{x:Bind local:PlaybackSpeedControl.Speed100}"
                Content="{x:Bind FormatPlaybackRate(local:PlaybackSpeedControl.Speed100)}"
                CornerRadius="16"
                IsChecked="{x:Bind sbui:DoubleHelper.AreClose(local:PlaybackSpeedControl.Speed100, PlaybackSession.PlaybackRate), Mode=OneWay}" />

            <ToggleButton
                Grid.Column="2"
                Padding="3,5,3,6"
                HorizontalAlignment="Stretch"
                Click="PlaybackRateToggleButton_OnClick"
                Command="{x:Bind PlaybackSession.SetPlaybackRateCommand}"
                CommandParameter="{x:Bind local:PlaybackSpeedControl.Speed150}"
                Content="{x:Bind FormatPlaybackRate(local:PlaybackSpeedControl.Speed150)}"
                CornerRadius="16"
                IsChecked="{x:Bind sbui:DoubleHelper.AreClose(local:PlaybackSpeedControl.Speed150, PlaybackSession.PlaybackRate), Mode=OneWay}" />

            <ToggleButton
                Grid.Column="3"
                Padding="3,5,3,6"
                HorizontalAlignment="Stretch"
                Click="PlaybackRateToggleButton_OnClick"
                Command="{x:Bind PlaybackSession.SetPlaybackRateCommand}"
                CommandParameter="{x:Bind local:PlaybackSpeedControl.Speed175}"
                Content="{x:Bind FormatPlaybackRate(local:PlaybackSpeedControl.Speed175)}"
                CornerRadius="16"
                IsChecked="{x:Bind sbui:DoubleHelper.AreClose(local:PlaybackSpeedControl.Speed175, PlaybackSession.PlaybackRate), Mode=OneWay}" />

            <ToggleButton
                Grid.Column="4"
                Padding="3,5,3,6"
                HorizontalAlignment="Stretch"
                Click="PlaybackRateToggleButton_OnClick"
                Command="{x:Bind PlaybackSession.SetPlaybackRateCommand}"
                CommandParameter="{x:Bind local:PlaybackSpeedControl.Speed200}"
                Content="{x:Bind FormatPlaybackRate(local:PlaybackSpeedControl.Speed200)}"
                CornerRadius="16"
                IsChecked="{x:Bind sbui:DoubleHelper.AreClose(local:PlaybackSpeedControl.Speed200, PlaybackSession.PlaybackRate), Mode=OneWay}" />
            <!--#endregion-->
        </Grid>
    </Grid>
</UserControl>
