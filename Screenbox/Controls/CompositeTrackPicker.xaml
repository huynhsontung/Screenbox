<UserControl
    x:Class="Screenbox.Controls.CompositeTrackPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedVisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:behaviors="using:Screenbox.Behaviors"
    xmlns:contract14Present="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract,14)"
    xmlns:ctConverters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="using:Screenbox.Core.Enums"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:strings="using:Screenbox.Strings"
    d:DesignHeight="492"
    d:DesignWidth="224"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ctConverters:DoubleToVisibilityConverter x:Key="GreaterThanZeroVisibilityConverter" GreaterThan="0" />

        <x:Double x:Key="TimingOffsetIncrement">50</x:Double>
        <x:Double x:Key="TimingOffsetDecrement">-50</x:Double>

        <DataTemplate x:Key="MediaTrackItemDataTemplate" x:DataType="x:String">
            <TextBlock
                HorizontalTextAlignment="DetectFromContent"
                Text="{x:Bind}"
                TextTrimming="{StaticResource MenuFlyoutItemTextTrimming}">
                <interactivity:Interaction.Behaviors>
                    <behaviors:OverflowTextToolTipBehavior />
                </interactivity:Interaction.Behaviors>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Width="224">
        <!--#region Composite-->
        <StackPanel x:Name="CompositePanel" Orientation="Vertical">
            <!--  Video tracks  -->
            <ListView
                ItemContainerTransitions="{x:Null}"
                ItemTemplate="{StaticResource MediaTrackItemDataTemplate}"
                ItemsSource="{x:Bind VideoDisplayList}"
                ScrollViewer.VerticalScrollMode="Disabled"
                SelectedIndex="{x:Bind ViewModel.VideoTrackIndex, Mode=TwoWay}"
                SelectionMode="Single"
                SingleSelectionFollowsFocus="False"
                Visibility="{x:Bind ViewModel.VideoTracks.Count, Mode=OneWay, Converter={StaticResource GreaterThanZeroVisibilityConverter}}">
                <ListView.Header>
                    <Grid MinHeight="{StaticResource ListViewItemMinHeight}" Margin="16,0,4,0">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind strings:Resources.Video}"
                            TextWrapping="NoWrap" />
                    </Grid>
                </ListView.Header>
                <ListView.Footer>
                    <MenuFlyoutSeparator IsTabStop="False" />
                </ListView.Footer>
            </ListView>
            <!--  Audio tracks  -->
            <ListView
                ItemContainerTransitions="{x:Null}"
                ItemTemplate="{StaticResource MediaTrackItemDataTemplate}"
                ItemsSource="{x:Bind AudioDisplayList}"
                ScrollViewer.VerticalScrollMode="Disabled"
                SelectedIndex="{x:Bind ViewModel.AudioTrackIndex, Mode=TwoWay}"
                SelectionMode="Single"
                SingleSelectionFollowsFocus="False">
                <ListView.Header>
                    <Grid MinHeight="{StaticResource ListViewItemMinHeight}" Margin="16,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind strings:Resources.Audio}"
                            TextWrapping="NoWrap">
                            <interactivity:Interaction.Behaviors>
                                <behaviors:OverflowTextToolTipBehavior />
                            </interactivity:Interaction.Behaviors>
                        </TextBlock>

                        <HyperlinkButton
                            Grid.Column="1"
                            Padding="{StaticResource HyperlinkButtonUniformPadding}"
                            contract14Present:AutomationProperties.AutomationControlType="Button"
                            Command="{x:Bind ViewModel.SetDisplayModeCommand}"
                            CommandParameter="{x:Bind enums:TrackPickerDisplayMode.Audio}"
                            Content="{x:Bind strings:Resources.Options}"
                            FontSize="{StaticResource CaptionTextBlockFontSize}" />
                    </Grid>
                </ListView.Header>
                <ListView.Footer>
                    <MenuFlyoutSeparator IsTabStop="False" />
                </ListView.Footer>
            </ListView>
            <!--  Subtitle tracks  -->
            <ListView
                ItemContainerTransitions="{x:Null}"
                ItemTemplate="{StaticResource MediaTrackItemDataTemplate}"
                ItemsSource="{x:Bind SubtitleDisplayList}"
                ScrollViewer.VerticalScrollMode="Disabled"
                SelectedIndex="{x:Bind ViewModel.SubtitleTrackIndex, Mode=TwoWay}"
                SelectionMode="Single"
                SingleSelectionFollowsFocus="False">
                <ListView.Header>
                    <Grid MinHeight="{StaticResource ListViewItemMinHeight}" Margin="16,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind strings:Resources.Subtitles}"
                            TextWrapping="NoWrap">
                            <interactivity:Interaction.Behaviors>
                                <behaviors:OverflowTextToolTipBehavior />
                            </interactivity:Interaction.Behaviors>
                        </TextBlock>

                        <HyperlinkButton
                            Grid.Column="1"
                            Padding="{StaticResource HyperlinkButtonUniformPadding}"
                            contract14Present:AutomationProperties.AutomationControlType="Button"
                            Command="{x:Bind ViewModel.SetDisplayModeCommand}"
                            CommandParameter="{x:Bind enums:TrackPickerDisplayMode.Subtitle}"
                            Content="{x:Bind strings:Resources.Options}"
                            FontSize="{StaticResource CaptionTextBlockFontSize}" />
                    </Grid>
                </ListView.Header>
                <ListView.Footer>
                    <ListViewItem Content="{x:Bind strings:Resources.AddSubtitle}">
                        <interactivity:Interaction.Behaviors>
                            <interactivity:EventTriggerBehavior EventName="Tapped">
                                <interactivity:InvokeCommandAction Command="{x:Bind ViewModel.AddSubtitleCommand}" />
                            </interactivity:EventTriggerBehavior>
                        </interactivity:Interaction.Behaviors>
                    </ListViewItem>
                </ListView.Footer>
            </ListView>
        </StackPanel>
        <!--#endregion-->

        <!--#region Audio Options-->
        <Grid x:Name="AudioOptionsGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button
                Grid.Row="0"
                Width="{StaticResource NavigationBackButtonWidth}"
                Height="{StaticResource NavigationBackButtonWidth}"
                Margin="4,2,4,2"
                Padding="0"
                BorderThickness="0"
                Command="{x:Bind ViewModel.SetDisplayModeCommand}"
                CommandParameter="{x:Bind enums:TrackPickerDisplayMode.Composite}"
                FontSize="16"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="{x:Bind strings:Resources.Back}">
                <muxc:AnimatedIcon
                    Width="16"
                    Height="16"
                    MirroredWhenRightToLeft="True">
                    <animatedVisuals:AnimatedBackVisualSource />
                    <muxc:AnimatedIcon.FallbackIconSource>
                        <muxc:FontIconSource
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Glyph="&#xE72B;"
                            MirroredWhenRightToLeft="True" />
                    </muxc:AnimatedIcon.FallbackIconSource>
                </muxc:AnimatedIcon>
            </Button>

            <TextBlock
                Grid.Row="0"
                Margin="48,0,8,0"
                VerticalAlignment="Center"
                Text="{x:Bind strings:Resources.Audio}" />

            <!--  Offset  -->
            <TextBlock
                Grid.Row="1"
                Margin="16,12,16,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind strings:Resources.TimingOffset}" />

            <Grid
                Grid.Row="2"
                Padding="12,0"
                FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    BorderThickness="0"
                    Command="{x:Bind PlaybackSession.AdjustAudioTimingOffsetCommand}"
                    CommandParameter="{StaticResource TimingOffsetDecrement}"
                    Content="&#xF8AB;"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="{StaticResource CaptionTextBlockFontSize}"
                    Style="{StaticResource SubtleButtonStyle}" />

                <Slider
                    Grid.Column="1"
                    Margin="8,0,8,0"
                    IsThumbToolTipEnabled="False"
                    Maximum="3000"
                    Minimum="-3000"
                    SmallChange="25"
                    StepFrequency="50"
                    Value="{x:Bind PlaybackSession.AudioTimingOffset, Mode=TwoWay}" />

                <Button
                    Grid.Column="2"
                    Width="32"
                    Height="32"
                    Padding="0"
                    BorderThickness="0"
                    Command="{x:Bind PlaybackSession.AdjustAudioTimingOffsetCommand}"
                    CommandParameter="{StaticResource TimingOffsetIncrement}"
                    Content="&#xF8AA;"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="{StaticResource CaptionTextBlockFontSize}"
                    Style="{StaticResource SubtleButtonStyle}" />
            </Grid>

            <TextBlock
                Grid.Row="3"
                Margin="12,8,12,11"
                HorizontalAlignment="Center"
                Typography.NumeralAlignment="Tabular"><Run Text="{x:Bind PlaybackSession.AudioTimingOffset, Mode=OneWay}" /> <Run Text="ms" /></TextBlock>
        </Grid>
        <!--#endregion-->

        <!--#region Subtitle Options-->
        <Grid x:Name="SubtitleOptionsGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button
                Grid.Row="0"
                Width="{StaticResource NavigationBackButtonWidth}"
                Height="{StaticResource NavigationBackButtonWidth}"
                Margin="4,2,4,2"
                Padding="0"
                BorderThickness="0"
                Command="{x:Bind ViewModel.SetDisplayModeCommand}"
                CommandParameter="{x:Bind enums:TrackPickerDisplayMode.Composite}"
                FontSize="16"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="{x:Bind strings:Resources.Back}">
                <muxc:AnimatedIcon
                    Width="16"
                    Height="16"
                    MirroredWhenRightToLeft="True">
                    <animatedVisuals:AnimatedBackVisualSource />
                    <muxc:AnimatedIcon.FallbackIconSource>
                        <muxc:FontIconSource
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Glyph="&#xE72B;"
                            MirroredWhenRightToLeft="True" />
                    </muxc:AnimatedIcon.FallbackIconSource>
                </muxc:AnimatedIcon>
            </Button>

            <TextBlock
                Grid.Row="0"
                Margin="48,0,8,0"
                VerticalAlignment="Center"
                Text="{x:Bind strings:Resources.Subtitles}" />

            <!--  Offset  -->
            <TextBlock
                Grid.Row="1"
                Margin="16,12,16,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind strings:Resources.TimingOffset}" />

            <Grid
                Grid.Row="2"
                Margin="12,0"
                FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    Padding="0"
                    BorderThickness="0"
                    Command="{x:Bind PlaybackSession.AdjustSubtitleTimingOffsetCommand}"
                    CommandParameter="{StaticResource TimingOffsetDecrement}"
                    Content="&#xF8AB;"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="{StaticResource CaptionTextBlockFontSize}"
                    Style="{StaticResource SubtleButtonStyle}" />

                <Slider
                    Grid.Column="1"
                    Margin="8,0,8,0"
                    IsThumbToolTipEnabled="False"
                    Maximum="3000"
                    Minimum="-3000"
                    SmallChange="25"
                    StepFrequency="50"
                    Value="{x:Bind PlaybackSession.SubtitleTimingOffset, Mode=TwoWay}" />

                <Button
                    Grid.Column="2"
                    Width="32"
                    Height="32"
                    Padding="0"
                    BorderThickness="0"
                    Command="{x:Bind PlaybackSession.AdjustSubtitleTimingOffsetCommand}"
                    CommandParameter="{StaticResource TimingOffsetIncrement}"
                    Content="&#xF8AA;"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="{StaticResource CaptionTextBlockFontSize}"
                    Style="{StaticResource SubtleButtonStyle}" />
            </Grid>

            <TextBlock
                Grid.Row="3"
                Margin="12,8,12,11"
                HorizontalAlignment="Center"
                Typography.NumeralAlignment="Tabular"><Run Text="{x:Bind PlaybackSession.SubtitleTimingOffset, Mode=OneWay}" /> <Run Text="ms" /></TextBlock>
        </Grid>
        <!--#endregion-->

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DisplayModeStates">
                <VisualState x:Name="CompositeOptionsVisible" />

                <VisualState x:Name="AudioOptionsVisible">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind IsTrackPickerDisplayMode(ViewModel.DisplayMode, enums:TrackPickerDisplayMode.Audio), Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CompositePanel.Visibility" Value="Collapsed" />
                        <Setter Target="AudioOptionsGrid.Visibility" Value="Visible" />
                    </VisualState.Setters>
                    <Storyboard>
                        <RepositionThemeAnimation FromHorizontalOffset="224" TargetName="AudioOptionsGrid" />
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="SubtitleOptionsVisible">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind IsTrackPickerDisplayMode(ViewModel.DisplayMode, enums:TrackPickerDisplayMode.Subtitle), Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CompositePanel.Visibility" Value="Collapsed" />
                        <Setter Target="SubtitleOptionsGrid.Visibility" Value="Visible" />
                    </VisualState.Setters>
                    <Storyboard>
                        <RepositionThemeAnimation FromHorizontalOffset="224" TargetName="SubtitleOptionsGrid" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
