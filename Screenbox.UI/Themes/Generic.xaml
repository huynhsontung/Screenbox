<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Screenbox.UI.Controls">

    <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

        <!--#region ContentUnavailableView-->
        <ResourceDictionary Source="ms-appx:///Screenbox.UI/Controls/ContentUnavailableView/ContentUnavailableView.xaml" />
        <!--#endregion-->

        <!--#region TitleBar-->
        <ResourceDictionary Source="ms-appx:///Screenbox.UI/Controls/TitleBar/TitleBar.xaml" />
        <!--#endregion-->
    </ResourceDictionary.MergedDictionaries>

    <Style BasedOn="{StaticResource DefaultCommandBarStyle}" TargetType="local:CommandBarEx" />
</ResourceDictionary>
