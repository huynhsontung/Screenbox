<Project>

  <!-- Platform configuration -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Language configuration -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- Output path configuration -->
  <PropertyGroup>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- Trimming switches -->
  <PropertyGroup>
    <CsWinRTAotWarningLevel>3</CsWinRTAotWarningLevel>

    <!-- C#/WinRT size‑saving options:
         Disable dynamic object support and manifest‑free activation to reduce binary size.
         References:
         https://github.com/microsoft/CsWinRT/blob/2.3.1.260716.1/nuget/readme.md#advanced-size-saving-options
         https://github.com/microsoft/CsWinRT/pull/1887
    -->
    <CsWinRTEnableDynamicObjectsSupport>false</CsWinRTEnableDynamicObjectsSupport>
    <CsWinRTEnableManifestFreeActivation>false</CsWinRTEnableManifestFreeActivation>

    <!-- WinRT does not require 'INotifyPropertyChanging' support.
         References:
         https://github.com/CommunityToolkit/dotnet/pull/911
         https://github.com/microsoft/CsWinRT/pull/2358
    -->
    <MvvmToolkitEnableINotifyPropertyChangingSupport>false</MvvmToolkitEnableINotifyPropertyChangingSupport>

    <!-- Suppress IL2104 (single warning for assembly producing trim warnings).
         SharpGen.Runtime and SharpDX (transitively referenced by LibVLCSharp.UWP) produce
         internal trim warnings that are benign for Screenbox's runtime execution. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Use C#/WinRT 2.3.1 directly to enable improved AOT analysis.
         The Windows 26100 SDK uses an older version lacking these enhancements. -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
  </ItemGroup>

  <!-- Global usings -->
  <ItemGroup>
    <Using Include="WinRT" />
  </ItemGroup>

</Project>